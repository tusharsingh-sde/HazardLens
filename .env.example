# ==============================================================================
# HazardLens Environment Variables Template
# Copy this file to .env and fill in your values: cp .env.example .env
# ==============================================================================

# ── Alert Dispatch (Resend API) ──────────────────────────────────────────────
# Free tier gives 3,000 emails/month at https://resend.com
RESEND_API_KEY=
HAZARDLENS_FROM_EMAIL=onboarding@resend.dev
HAZARDLENS_ADMIN_EMAIL=

# ── Operator Authentication ──────────────────────────────────────────────────
# 4-digit PIN required to unlock ARM, DISARM, and SILENCE controls (default: 1234)
HAZARDLENS_OPERATOR_PIN=1234

# ── Model Integrity Check ────────────────────────────────────────────────────
# SHA-256 hash of best.pt for tamper verification on startup
HAZARDLENS_MODEL_SHA256=18d47a2e606035a2f1b5303050125a3c6c53b679a7a1b27b25bd72d7a63b3ec3

# ── Camera Auth & Discovery Defaults ─────────────────────────────────────────
# Default credentials and port used during camera discovery / Cloudflare pairing
HAZARDLENS_CAM_USER=cam01
HAZARDLENS_CAM_SECRET=
HAZARDLENS_CAM_PORT=8080

# Direct camera stream override (bypasses discovery if set)
# HAZARDLENS_DRONE_URL=https://<subdomain>.trycloudflare.com/video

# ── Video Streaming Server (MJPEG) ───────────────────────────────────────────
# Internal MJPEG port (default: 8502)
MJPEG_PORT=8502

# Stream URL consumed by front-end <img> tag:
# Local dev: http://localhost:8502/stream
# Docker / Azure (via Nginx proxy): /stream
MJPEG_STREAM_URL=http://localhost:8502/stream

# ── Ultralytics Cache Directory (Docker non-root safety) ─────────────────────
# YOLO_CONFIG_DIR=/tmp/ultralytics
